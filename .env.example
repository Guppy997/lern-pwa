# Kopieren nach .env und ausfüllen: cp .env.example .env
# Die echte .env nie committen (steht in .gitignore).

# Auth-Key für den Tailscale-Sidecar (Service ts-lern in docker-compose.yml).
# Erzeugen in der Tailscale-Admin-Konsole mit dem Tag tag:pwa-sidecar, den die
# Tailnet-ACL als tagOwner kennen muss (siehe README, "Selbst hosten").
# Nach dem ersten Start merkt sich der Container seinen Zustand im Volume
# ts-lern-state, der Key wird danach nicht mehr gebraucht.
TS_AUTHKEY=
